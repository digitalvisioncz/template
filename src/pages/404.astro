---
export const status = 404;
---

<div class="not-found">
  <h1>404</h1>
  <p>Page not found.</p>
  <a href="/">Go home</a>
</div>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    gap: var(--space-4);
    text-align: center;
    padding: var(--space-8) var(--space-4);
  }
  h1 {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
  }
  a {
    color: var(--color-accent);
    text-decoration: underline;
    font-weight: 600;
  }
</style>
