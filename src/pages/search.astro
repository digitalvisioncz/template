---
import Shop from "../layouts/Shop.astro";

const title = "Search";
const query = Astro.url.searchParams.get("q") || "";

let results: any[] = [];
let error: string | null = null;

if (query) {
  try {
    const { shopifyQuery } = await import("../lib/shopify/index");
    const { GET_PRODUCTS } = await import("../lib/shopify/queries/shop");
    const res = await shopifyQuery<{ products: { edges: { node: any }[] } }>({
      query: GET_PRODUCTS,
      variables: { query: `title:*${query}*`, first: 24 },
    });
    results = res.products?.edges?.map((e) => e.node).filter(Boolean) || [];
  } catch (e) {
    console.error("Search fetch failed:", e);
    error = "Search failed";
  }
}
---

<Shop title={title}>
  <div class="page">
    <div class="container">
      <h1>Search</h1>
      <form method="get" class="search-form">
        <input type="text" name="q" defaultValue={query} placeholder="Search products..." />
        <button type="submit">Search</button>
      </form>
      {error && <p class="error">{error}</p>}
      {results.length === 0 && query && <p>No results for "{query}"</p>}
      {results.length > 0 && (
        <div class="product-grid">
          {results.map((p) => (
            <a href={`/products/${p.handle}`} class="card">
              {p.featuredImage ? (
                <img src={p.featuredImage.url} alt={p.title} />
              ) : p.images?.edges?.[0]?.node ? (
                <img src={p.images.edges[0].node.url} alt={p.title} />
              ) : null}
              <h3>{p.title}</h3>
              <p>
                {p.priceRange.minVariantPrice.amount} {p.priceRange.minVariantPrice.currencyCode}
              </p>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</Shop>

<style>
  .page { padding: var(--space-8) var(--space-4); }
  .search-form { display: flex; gap: var(--space-3); margin-bottom: var(--space-6); }
  input, button[type="submit"] { padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); border: 1px solid var(--color-border); }
  button[type="submit"] { background: var(--color-accent); color: var(--color-accent-text); border-color: transparent; }
  .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: var(--space-6); }
  .card { display: flex; flex-direction: column; gap: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
  .card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; }
  .card h3 { font-size: 0.9375rem; font-weight: 600; padding: 0 var(--space-3); }
  .card p { padding: 0 var(--space-3) var(--space-3); font-weight: 600; }
  .container { max-width: var(--container-max); margin: 0 auto; }
</style>
