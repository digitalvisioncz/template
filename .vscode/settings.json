{
    "eslint.useFlatConfig": true,
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "astro"
    ],
    "stylelint.validate": [
        "css"
    ],
    "stylelint.packageManager": "pnpm",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint": "explicit"
    },
    "files.associations": {
        "*.astro": "astro",
        "*.css": "css"
    }
}
